# ---- Backend ----
# Where the SQLite database lives. In Docker/Railway use a mounted volume,
# e.g. sqlite:////data/tunneling.db ; locally leave default (./tunneling.db).
# TUNNEL_DB_URL=sqlite:///./tunneling.db

# Port the web service listens on (Render/Railway inject $PORT automatically).
# PORT=8000

# ---- AI Assistant (OpenAI-compatible relay / BIG PICKLE) ----
# For cloud deploys this MUST be a public URL reachable from the server
# (a local "localhost:20128" will NOT work from Render/Railway).
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_MODEL=oc/big-pickle

# ---- Optional fallback provider ----
# GEMINI_API_KEY=

# ---- Frontend build-time API base ----
# Leave empty when FastAPI serves the built frontend (same origin).
# Set only if you host the frontend separately, e.g. VITE_API_URL=https://api.example.com
# VITE_API_URL=
