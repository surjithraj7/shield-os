# ---- Backend ----
# Where the SQLite database lives. In Docker/Railway use a mounted volume,
# e.g. sqlite:////data/tunneling.db ; locally leave default (./tunneling.db).
# TUNNEL_DB_URL=sqlite:///./tunneling.db

# Port the web service listens on (Render/Railway inject $PORT automatically).
# PORT=8000

# ---- AI Assistant (NVIDIA NIM / Moonshot Kimi-k3 / OpenAI / Gemini) ----
# NVIDIA Cloud API or Triton Inference Server (nvcr.io/nvidia/tritonserver:26.07-trtllm-python-py3)
NVIDIA_API_KEY=nvapi-REPLACE_WITH_YOUR_KEY
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=moonshotai/kimi-k3
TRITON_SERVER_IMAGE=nvcr.io/nvidia/tritonserver:26.07-trtllm-python-py3

# OpenAI-compatible relay
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_MODEL=auto/best-coding

# Optional fallback provider
# GEMINI_API_KEY=

# ---- Frontend build-time API base ----
# Leave empty when FastAPI serves the built frontend (same origin).
# Set only if you host the frontend separately, e.g. VITE_API_URL=https://api.example.com
# VITE_API_URL=

# Google Maps JavaScript API key (required for GIS satellite map)
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

