# ---- Backend ----
# Where the SQLite database lives. In Docker/Railway use a mounted volume,
# e.g. sqlite:////data/tunneling.db ; locally leave default (./tunneling.db).
# TUNNEL_DB_URL=sqlite:///./tunneling.db

# Port the web service listens on (Render/Railway inject $PORT automatically).
# PORT=8000

# ---- Runtime / initial accounts ----
# Set to production on hosted deployments. Production startup requires a strong
# SHIELD_ADMIN_PASSWORD and refuses to create known default credentials.
# SHIELD_ENV=development
# SHIELD_SEED_DEMO=true
# SHIELD_ADMIN_USERNAME=admin
# SHIELD_ADMIN_PASSWORD=
# SHIELD_OPERATOR_USERNAME=operator
# SHIELD_OPERATOR_PASSWORD=

# ---- AI Assistant (NVIDIA NIM / Moonshot Kimi-k3 / OpenAI / Gemini) ----
# NVIDIA Cloud API or Triton Inference Server (nvcr.io/nvidia/tritonserver:26.07-trtllm-python-py3)
NVIDIA_API_KEY=nvapi-REPLACE_WITH_YOUR_KEY
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=moonshotai/kimi-k3
TRITON_SERVER_IMAGE=nvcr.io/nvidia/tritonserver:26.07-trtllm-python-py3

# OpenAI-compatible relay
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# Set this to a public OpenAI-compatible endpoint in production; the localhost
# relay below only exists on a developer machine.
# OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_MODEL=auto/best-coding

# Optional OpenRouter fallback
# OPENROUTER_API_KEY=


# Optional fallback provider
# GEMINI_API_KEY=

# ---- Security / IoT ----
# Comma-separated allowed browser origins. Production defaults to same-origin plus
# RENDER_EXTERNAL_URL; localhost defaults are only used when not in production.
# CORS_ORIGINS=https://your-custom-domain.example
# PUBLIC_APP_URL=  # optional custom domain to add to CORS
# Optional device key for POST /api/iot/readings (X-API-Key header).
# Leave empty to require an operator/admin bearer token instead.
# IOT_INGEST_API_KEY=replace-with-a-long-random-secret
# Optional JSON overrides for the explainable risk engine thresholds.
# RISK_THRESHOLDS_JSON={"settlement":{"unit":"mm","moderate":10,"high":20,"critical":30}}
# Demo sensor data is always labelled source="simulated". Real gateways must send
# source="real" and a stable event_id for idempotent ingestion.

# ---- Frontend build-time API base ----
# Leave empty when FastAPI serves the built frontend (same origin).
# Set only if you host the frontend separately, e.g. VITE_API_URL=https://api.example.com
# VITE_API_URL=

# Google Maps JavaScript API key (public browser key; restrict by HTTP referrer)
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

